--- Clausula WHERE para filtrar os resultados de uma consulta

SELECT NOME, DTNASCIMENTO, SEXO
FROM ALUNO
WHERE SEXO = 'F';
--- AND
SELECT NOME, DTNASCIMENTO, SEXO
FROM ALUNO
WHERE SEXO = 'F' AND EXTRACT (MONTH FROM DTNASCIMENTO)=11;

--- IN (DENTRO DE)
SELECT NOME, DTNASCIMENTO, SEXO
FROM ALUNO
WHERE EXTRACT (MONTH FROM DTNASCIMENTO) IN (7,8,9,10);

--- BETWEEN (ENTRE)
SELECT NOME, DTNASCIMENTO, SEXO
FROM ALUNO
WHERE EXTRACT (YEAR FROM DTNASCIMENTO) BETWEEN 1985 AND 2005;

--- LIKE (PARECIDO COM)
SELECT NOME
FROM ALUNO
WHERE NOME LIKE '%COSTA%'; --- IMPORTANTE: O caractere % representa qualquer sequência de caracteres, incluindo uma sequência vazia. O caractere _ representa um único caractere.

